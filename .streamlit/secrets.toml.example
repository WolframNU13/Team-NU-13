# Copy this file to .streamlit/secrets.toml and put YOUR OWN key in it.
# ChronoAgent then works without pasting the key into the sidebar each time.
# secrets.toml is listed in .gitignore; never commit it or share screenshots of it.
#
# Use ONE of these:
GEMINI_API_KEY = "AIza...your-google-ai-studio-key..."
# OPENROUTER_API_KEY = "sk-or-...your-openrouter-key..."
#
# Optional: pin a model (otherwise the free default models are tried in turn)
# CHRONOAGENT_MODEL = "gemini-2.5-flash"
